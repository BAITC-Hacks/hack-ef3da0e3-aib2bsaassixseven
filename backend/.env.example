APP_NAME=Tirke API
# Exact browser origin of the Next.js app (scheme, host, and port; no path).
FRONTEND_ORIGIN=http://localhost:3000
# Use the same Supabase project and publishable key as frontend/.env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
# Relative to the backend working directory; use an absolute path in deployment.
DATA_ROOT=data
# Backend-only. Uncomment both after deploying the authenticated inference HTTP API.
# For the SSH tunnel in backend/README.md, use http://127.0.0.1:8765.
# GPU_API_URL=<inference-api-base-url>
# GPU_API_TOKEN=<service-token>
